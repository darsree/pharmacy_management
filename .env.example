# Groq API key - powers the AI assistant, prescription validation and the
# prescription PHOTO reader. Get one at https://console.groq.com
# Without it the app still works: validation falls back to the built-in rule
# engine, and only the photo upload needs the key.
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Optional: force specific Groq models (comma-free, one model id each)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
